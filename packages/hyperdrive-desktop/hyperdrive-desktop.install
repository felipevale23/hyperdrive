post_install() {
    systemctl enable sddm.service || true
    systemctl enable docker.service || true
    getent group docker >/dev/null || groupadd docker
    getent group input >/dev/null || groupadd input
    cat <<'EOF'

  hyperdrive-desktop installed.

  Next:
    * add yourself to the docker + input groups:  usermod -aG docker,input <you>
      (input = raw /dev/input access for the Alt-Tab workspace switcher)
    * finish the desktop as your user:    hyperdrive-setup
      (end-4 + patches + dotfiles + GRUB theme + services)
    * reboot

EOF
}

post_upgrade() {
    post_install
}
