# Maintainer: felipevale23
# Meta package: pulls the whole hyperdrive desktop stack and wires up services.
pkgname=hyperdrive-desktop
pkgver=0.1.0
pkgrel=1
pkgdesc="hyperdrive — Arch + Hyprland (end-4) desktop meta package"
arch=('any')
url="https://github.com/felipevale23/hyperdrive"
license=('MIT')
install="${pkgname}.install"
depends=(
    # session
    hyprland xdg-desktop-portal-hyprland sddm kitty polkit
    qt5-wayland qt6-wayland
    # GL/Vulkan baseline — vendor drivers are picked by hyperdrive-setup
    # (autodetect / HYPERDRIVE_GPU); see optdepends
    mesa vulkan-icd-loader
    # end-4 shell deps that live in official repos
    quickshell wl-clipboard cliphist brightnessctl ddcutil
    hypridle hyprlock hyprpicker wlogout fuzzel
    dart-sass matugen
    # audio
    pipewire pipewire-alsa pipewire-pulse wireplumber pavucontrol
    # sddm sugar-dark (Qt5) runtime
    qt5-declarative qt5-graphicaleffects qt5-quickcontrols2 qt5-svg
    # boot / containers
    grub efibootmgr os-prober docker docker-buildx docker-compose
    # shell + cli
    zsh zoxide eza bat fzf fd ripgrep jq bottom btop neovim unzip wget
    # dev toolchain (asdf-vm manages project-local versions on top of these)
    nodejs npm yarn python-pip python-pipx rustup
    # desktop utils + file manager (Dolphin replaces nautilus as the default)
    dolphin dolphin-plugins ark kio-extras kdegraphics-thumbnailers
    kcalc kdeconnect sshfs xdg-utils
    # fonts (ttf-jetbrains-mono-nerd is the kitty default in dotfiles/.config/kitty)
    ttf-firacode-nerd ttf-jetbrains-mono-nerd ttf-meslo-nerd ttf-nerd-fonts-symbols
    noto-fonts noto-fonts-emoji ttf-liberation ttf-fira-code
    # net
    networkmanager
    hyperdrive-dotfiles
)
optdepends=(
    'sddm-sugar-dark: login theme (AUR / [hyperdrive] repo)'
    'oh-my-posh: zsh prompt (AUR / [hyperdrive] repo)'
    'asdf-vm: per-project runtime version manager (AUR)'
    'lunarvim: the lvim editor the dotfiles expect (AUR / installer)'
    'vulkan-radeon: AMD GPU (Vulkan)'
    'libva-mesa-driver: AMD GPU (VA-API)'
    'vulkan-intel: Intel GPU (Vulkan)'
    'intel-media-driver: Intel GPU (VA-API, gen9+)'
    'nvidia-lts: NVIDIA GPU driver for the linux-lts kernel'
    'nvidia-utils: NVIDIA userspace (needed with nvidia-lts)'
    'libva-nvidia-driver: NVIDIA VA-API on Wayland'
)

package() {
    install -d "${pkgdir}/usr/share/${pkgname}"
    echo "${pkgver}" > "${pkgdir}/usr/share/${pkgname}/VERSION"
}
