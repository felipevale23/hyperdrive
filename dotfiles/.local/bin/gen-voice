#!/usr/bin/python3
"""Reads text aloud with a voice from VoiceStudio, on this computer.

  gen-voice "TEXT" OUTPUT.wav [VOICE NAME]

Without a name it uses the voice in ~/.config/gen-voice-default, then the Demo Voice.
Starts VoiceStudio with analytics off if it isn't running. Takes about 5 seconds per
second of speech on the CPU. Prints the final path. An existing file is never replaced.
"""
import json
import os
import pathlib
import secrets
import subprocess
import sys
import time
import urllib.error
import urllib.request

API = "http://127.0.0.1:3900"
APP = pathlib.Path.home() / "Applications/VoiceStudio-0.5.7-linux-x64.AppImage"
DEFAULT = pathlib.Path.home() / ".config/gen-voice-default"
MAX_CHARS = 2000
START_TIMEOUT = 120  # seconds
GENERATE_TIMEOUT = 900


def get(path):
    with urllib.request.urlopen(API + path, timeout=5) as reply:
        return json.load(reply)


def ready():
    try:
        return get("/health").get("status") == "ok"
    except (OSError, ValueError):
        return False


def start():
    if ready():
        return
    subprocess.Popen([str(APP)], env={**os.environ, "OMNIVOICE_ANALYTICS_DISABLED": "1"}, start_new_session=True,
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    deadline = time.time() + START_TIMEOUT
    while time.time() < deadline:
        if ready():
            return
        time.sleep(2)
    sys.exit("VoiceStudio did not start")


def find_voice(name):
    wanted = name or (DEFAULT.read_text().strip() if DEFAULT.exists() else "") or "Demo Voice"
    profiles = get("/profiles")
    for profile in profiles:
        if profile["name"].lower() == wanted.lower():
            return profile
    sys.exit(f"no voice called {wanted}. Voices: {', '.join(p['name'] for p in profiles)}")


def speak(text, profile):
    boundary = secrets.token_hex(16)
    fields = {"text": text, "language": "Portuguese (Brazil)", "profile_id": profile["id"]}
    body = "".join(f'--{boundary}\r\nContent-Disposition: form-data; name="{key}"\r\n\r\n{value}\r\n'
                   for key, value in fields.items()) + f"--{boundary}--\r\n"
    request = urllib.request.Request(API + "/generate", data=body.encode(), method="POST",
                                     headers={"Content-Type": f"multipart/form-data; boundary={boundary}"})
    try:
        with urllib.request.urlopen(request, timeout=GENERATE_TIMEOUT) as reply:
            return reply.read()
    except urllib.error.HTTPError as error:
        sys.exit(f"VoiceStudio refused ({error.code}): {error.read().decode(errors='replace')[:300]}")


def main():
    if len(sys.argv) not in (3, 4) or not sys.argv[1].strip():
        sys.exit(__doc__)
    text, output = sys.argv[1], pathlib.Path(sys.argv[2])
    if len(text) > MAX_CHARS:
        sys.exit(f"text too long: {len(text)} characters, the limit is {MAX_CHARS}")
    if output.suffix.lower() != ".wav":
        sys.exit("OUTPUT must end in .wav")
    if output.exists():
        sys.exit(f"{output} already exists")
    start()
    audio = speak(text, find_voice(sys.argv[3] if len(sys.argv) == 4 else ""))
    if audio[:4] != b"RIFF":
        sys.exit(f"VoiceStudio did not return audio: {audio[:200]!r}")
    with open(output, "xb") as file:
        file.write(audio)
    print(output.resolve())


if __name__ == "__main__":
    main()
