# ~/.zshrc_secrets — copy to ~/.zshrc_secrets, fill in, then: chmod 600 ~/.zshrc_secrets
# Sourced at the end of ~/.zshrc_custom. NEVER commit the real file.

# export GIT_USER="your-github-username"
# export GIT_TOKEN="ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# export GIT_DEPLOY_TOKEN="ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# export GEMINI_API_KEY="AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Oracle Cloud (optional)
