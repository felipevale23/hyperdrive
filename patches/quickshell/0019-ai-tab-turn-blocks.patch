+import qs.modules.common
+import qs.modules.common.widgets
+import QtQuick
+import QtQuick.Layouts
+
+/**
+ * A short line from the tab itself, inside a reply. Plain text, because file names come from the model.
+ */
+RowLayout {
+    id: root
+    property var block: ({})
+
+    Layout.fillWidth: true
+    Layout.topMargin: 4
+    Layout.bottomMargin: 4
+    Layout.leftMargin: 10
+    Layout.rightMargin: 10
+    spacing: 8
+
+    MaterialSymbol {
+        Layout.alignment: Qt.AlignTop
+        text: root.block.icon ?? "info"
+        iconSize: Appearance.font.pixelSize.normal
+        color: root.block.tone === "error" ? Appearance.colors.colError : Appearance.colors.colOnSurfaceVariant
+    }
+    StyledText {
+        Layout.fillWidth: true
+        textFormat: Text.PlainText
+        wrapMode: Text.Wrap
+        font.pixelSize: Appearance.font.pixelSize.small
+        color: Appearance.colors.colOnSurfaceVariant
+        text: root.block.text ?? ""
+    }
+}
diff --git a/modules/ii/sidebarLeft/aiChat/MessagePermissionBlock.qml b/modules/ii/sidebarLeft/aiChat/MessagePermissionBlock.qml
new file mode 100644
index 0000000..9934498
--- /dev/null
+++ b/modules/ii/sidebarLeft/aiChat/MessagePermissionBlock.qml
@@ -0,0 +1,161 @@
+pragma ComponentBehavior: Bound
+
+import qs.services
+import qs.modules.common
+import qs.modules.common.widgets
+import QtQuick
+import QtQuick.Layouts
+
+/**
+ * Something OpenCode needs an answer to. A live card sits in a fence only this message knows, so a
+ * model can't print its own Approve button. Plain text throughout, because paths come from the model.
+ */
+Rectangle {
+    id: root
+    property var block: ({})
+    property var messageData: {}
+    readonly property bool live: block.live ?? false
+    readonly property bool allowed: block.state === "allowed"
+    readonly property bool hasDetail: (block.detail ?? "").length > 0
+    property bool detailShown: live
+
+    component AnswerButton: RippleButton {
+        id: answerButton
+        property alias label: answerLabel.text
+        property color colLabel
+        Layout.fillWidth: true
+        Layout.preferredWidth: 1
+        implicitHeight: 36
+        buttonRadius: Appearance.rounding.full
+        activeFocusOnTab: true
+        Keys.onReturnPressed: clicked()
+        Keys.onEnterPressed: clicked()
+        Accessible.name: answerLabel.text
+        contentItem: StyledText {
+            id: answerLabel
+            horizontalAlignment: Text.AlignHCenter
+            verticalAlignment: Text.AlignVCenter
+            font.pixelSize: Appearance.font.pixelSize.small
+            color: answerButton.colLabel
+        }
+        Rectangle { // Keyboard focus
+            anchors.fill: parent
+            radius: Appearance.rounding.full
+            color: "transparent"
+            border.width: answerButton.activeFocus ? 2 : 0
+            border.color: Appearance.colors.colOnLayer1
+        }
+    }
+
+    Layout.fillWidth: true
+    Layout.topMargin: 4
+    Layout.bottomMargin: 4
+    implicitHeight: cardColumn.implicitHeight + 12 * 2
+    radius: Appearance.rounding.normal
+    color: root.live ? Appearance.colors.colSurfaceContainerHighest : Appearance.colors.colLayer2
+
+    ColumnLayout {
+        id: cardColumn
+        anchors {
+            left: parent.left
+            right: parent.right
+            top: parent.top
+            margins: 12
+        }
+        spacing: 8
+
+        RowLayout { // Who asks, and for what
+            Layout.fillWidth: true
+            spacing: 10
+            MaterialSymbol {
+                Layout.alignment: Qt.AlignTop
+                text: root.live ? "shield_question" : (root.allowed ? "check_circle" : "block")
+                iconSize: Appearance.font.pixelSize.larger
+                color: root.live ? Appearance.colors.colPrimary : (root.allowed ? Appearance.colors.colOnSurfaceVariant : Appearance.colors.colError)
+            }
+            ColumnLayout {
+                Layout.fillWidth: true
+                spacing: 2
+                StyledText {
+                    Layout.fillWidth: true
+                    textFormat: Text.PlainText
+                    wrapMode: Text.WrapAnywhere
+                    font.pixelSize: Appearance.font.pixelSize.small
+                    font.weight: Font.DemiBold
+                    color: Appearance.colors.colOnLayer2
+                    text: root.block.title ?? ""
+                }
+                StyledText { // Why it asks, or how it ended
+                    visible: text.length > 0
+                    Layout.fillWidth: true
+                    textFormat: Text.PlainText
+                    wrapMode: Text.Wrap
+                    font.pixelSize: Appearance.font.pixelSize.smaller
+                    color: Appearance.colors.colOnSurfaceVariant
+                    text: root.live ? (root.block.reason ?? "") : (root.block.outcome ?? "")
+                }
+            }
+            RippleButton { // An answered card keeps its detail one click away
+                visible: !root.live && root.hasDetail
+                Layout.alignment: Qt.AlignTop
+                implicitWidth: 26
+                implicitHeight: 26
+                buttonRadius: Appearance.rounding.full
+                colBackgroundHover: Appearance.colors.colLayer2Hover
+                colRipple: Appearance.colors.colLayer2Active
+                onClicked: root.detailShown = !root.detailShown
+                Accessible.name: Translation.tr("Show details")
+                contentItem: MaterialSymbol {
+                    horizontalAlignment: Text.AlignHCenter
+                    verticalAlignment: Text.AlignVCenter
+                    text: "keyboard_arrow_down"
+                    iconSize: Appearance.font.pixelSize.normal
+                    color: Appearance.colors.colOnSurfaceVariant
+                    rotation: root.detailShown ? 180 : 0
+                }
+            }
+        }
+
+        Loader { // The exact command, diff or path
+            active: root.hasDetail && root.detailShown
+            visible: active
+            Layout.fillWidth: true
+            sourceComponent: MessageCodeBlock {
+                bare: true
+                segmentContent: root.block.detail
+                segmentLang: root.block.lang ?? "txt"
+                messageData: root.messageData
+            }
+        }
+
+        StyledText { // What Approve does
+            visible: root.live
+            Layout.fillWidth: true
+            textFormat: Text.PlainText
+            wrapMode: Text.Wrap
+            font.pixelSize: Appearance.font.pixelSize.smaller
+            color: Appearance.colors.colOnSurfaceVariant
+            text: root.block.effect ?? ""
+        }
+
+        RowLayout { // Same size, and neither is a default
+            visible: root.live
+            Layout.fillWidth: true
+            spacing: 8
+            AnswerButton {
+                label: Translation.tr("Reject")
+                colLabel: Appearance.colors.colOnLayer2
+                colBackground: Appearance.colors.colLayer3
+                colBackgroundHover: Appearance.colors.colLayer3Hover
+                colRipple: Appearance.colors.colLayer3Active
+                onClicked: Ai.rejectCommand(root.messageData)
+            }
+            AnswerButton {
+                toggled: true
+                label: Translation.tr("Approve")
+                colLabel: Appearance.colors.colOnPrimary
+                onClicked: Ai.approveCommand(root.messageData)
+            }
+        }
+    }
+}
