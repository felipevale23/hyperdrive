     }
 
+    /**
+     * Splits a message that may hold OpenCode's own blocks. Those are pulled out first, by their secret
+     * fences, so nothing a model writes around them can hide one, and the text between is parsed alone.
+     * Steps next to each other, thoughts and tools, become one activity block.
+     * @param { string } markdown
+     * @param { string } systemFence
+     * @param { string } liveFence The fence of the card still waiting for an answer
+     */
+    function splitMessageBlocks(markdown, systemFence, liveFence) {
+        if (!markdown) return [];
+        if (!systemFence) return root.splitMarkdownBlocks(markdown);
+        const fences = liveFence ? `${systemFence}|${liveFence}` : systemFence;
+        const regex = new RegExp("```(" + fences + ")\\n(.*)\\n```", "g");
+        const blocks = [];
+        let lastIndex = 0;
+        let match;
+        while ((match = regex.exec(markdown)) !== null) {
+            blocks.push(...root.splitMarkdownBlocks(markdown.slice(lastIndex, match.index)));
+            lastIndex = regex.lastIndex;
+            try {
+                const block = JSON.parse(match[2]);
+                blocks.push(Object.assign(block, { type: block.kind, live: match[1] === liveFence }));
+            } catch (e) {
+                console.log("[AI] Bad system block: ", e);
+            }
+        }
+        blocks.push(...root.splitMarkdownBlocks(markdown.slice(lastIndex)));
+        const result = [];
+        for (const block of blocks) {
+            if (block.type !== "think" && block.type !== "tool") {
+                result.push(block);
+                continue;
+            }
+            const last = result[result.length - 1];
+            if (last?.type === "activity") last.steps.push(block);
+            else result.push({ type: "activity", steps: [block] });
+        }
+        return result;
+    }
+
+    /**
+     * What a person would want to copy: the message without OpenCode's own blocks.
+     */
+    function withoutSystemBlocks(markdown, systemFence) {
+        if (!systemFence) return markdown;
+        return markdown.replace(new RegExp("```(" + systemFence + "|permission_\\w+)\\n.*\\n```", "g"), "").trim();
+    }
+
     /**
      * Splits markdown blocks into three different types: text, think, and code.
      * @param { string } markdown
