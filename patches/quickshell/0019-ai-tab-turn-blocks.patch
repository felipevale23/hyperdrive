diff --git a/modules/ii/sidebarLeft/aiChat/MessageActivityBlock.qml b/modules/ii/sidebarLeft/aiChat/MessageActivityBlock.qml
new file mode 100644
index 0000000..f9edfaf
--- /dev/null
+++ b/modules/ii/sidebarLeft/aiChat/MessageActivityBlock.qml
@@ -0,0 +1,120 @@
+pragma ComponentBehavior: Bound
+
+import qs.services
+import qs.modules.common
+import qs.modules.common.widgets
+import qs.modules.common.functions
+import QtQuick
+import QtQuick.Layouts
+
+/**
+ * What OpenCode did between two pieces of a reply: thoughts and tool steps, as one quiet row.
+ * Failures open by themselves. Plain text throughout, because targets come from the model.
+ */
+ColumnLayout {
+    id: root
+    property var steps: []
+    readonly property var tools: steps.filter(step => step.type === "tool")
+    readonly property int failed: tools.filter(step => !step.ok).length
+    property bool expanded: failed > 0
+
+    readonly property string summary: {
+        if (tools.length === 0) return Translation.tr("Thought");
+        if (failed > 0) return tools.length === 1 ? Translation.tr("%1: failed").arg(tools[0].text)
+            : Translation.tr("%1 steps, %2 failed").arg(tools.length).arg(failed);
+        if (tools.length === 1) return tools[0].text;
+        if (tools.every(step => step.name === "read")) return Translation.tr("Read %1 files").arg(tools.length);
+        if (tools.every(step => step.name === "edit")) return Translation.tr("Edited %1 files").arg(tools.length);
+        return Translation.tr("%1 steps").arg(tools.length);
+    }
+
+    function iconOf(step) {
+        if (step.type === "think") return "linked_services";
+        if (!step.ok) return "error";
+        switch (step.name) {
+        case "read": return "description";
+        case "edit":
+        case "write": return "edit_note";
+        case "shell": return "terminal";
+        case "grep":
+        case "glob":
+        case "websearch": return "search";
+        case "webfetch": return "public";
+        case "subagent": return "smart_toy";
+        }
+        return "build";
+    }
+
+    Layout.fillWidth: true
+    spacing: 0
+
+    RippleButton { // Summary, click to open
+        Layout.fillWidth: true
+        implicitHeight: 30
+        buttonRadius: Appearance.rounding.small
+        colBackgroundHover: Appearance.colors.colLayer2Hover
+        colRipple: Appearance.colors.colLayer2Active
+        onClicked: root.expanded = !root.expanded
+        Accessible.name: root.summary
+
+        contentItem: RowLayout {
+            spacing: 8
+            MaterialSymbol {
+                Layout.leftMargin: 3
+                text: root.failed > 0 ? "error" : root.iconOf(root.steps[root.steps.length - 1])
+                iconSize: Appearance.font.pixelSize.normal
+                color: root.failed > 0 ? Appearance.colors.colError : Appearance.colors.colOnSurfaceVariant
+            }
+            StyledText {
+                Layout.fillWidth: true
+                textFormat: Text.PlainText
+                elide: Text.ElideMiddle
+                font.pixelSize: Appearance.font.pixelSize.small
+                color: Appearance.colors.colOnSurfaceVariant
+                text: root.summary
+            }
+            MaterialSymbol {
+                Layout.rightMargin: 3
+                text: "keyboard_arrow_down"
+                iconSize: Appearance.font.pixelSize.normal
+                color: Appearance.colors.colOnSurfaceVariant
+                rotation: root.expanded ? 180 : 0
+            }
+        }
+    }
+
+    ColumnLayout { // Every step
+        visible: root.expanded
+        Layout.fillWidth: true
+        Layout.leftMargin: 10
+        Layout.rightMargin: 10
+        Layout.topMargin: 2
+        Layout.bottomMargin: 4
+        spacing: 4
+
+        Repeater {
+            model: root.steps
+            delegate: RowLayout {
+                id: stepRow
+                required property var modelData
+                Layout.fillWidth: true
+                spacing: 8
+                MaterialSymbol {
+                    Layout.alignment: Qt.AlignTop
+                    text: root.iconOf(stepRow.modelData)
+                    iconSize: Appearance.font.pixelSize.normal
+                    color: stepRow.modelData.type === "tool" && !stepRow.modelData.ok ? Appearance.colors.colError : Appearance.colors.colOnSurfaceVariant
+                }
+                StyledText {
+                    Layout.fillWidth: true
+                    textFormat: Text.PlainText
+                    wrapMode: Text.Wrap
+                    font.pixelSize: Appearance.font.pixelSize.small
+                    color: Appearance.colors.colOnSurfaceVariant
+                    text: stepRow.modelData.type === "think" ? stepRow.modelData.content.trim()
+                        : (stepRow.modelData.ok || !stepRow.modelData.error ? stepRow.modelData.text : `${stepRow.modelData.text}\n${stepRow.modelData.error}`)
+                }
+            }
+        }
+    }
+}
