@@ -0,0 +1,219 @@
+import qs.modules.common
+import qs.modules.common.widgets
+import qs.services
+import QtQuick
+import QtQuick.Layouts
+
+/**
+ * 9router in one place, like the agents panel is for agents: a switch to start or stop it,
+ * today's numbers, which token savers are on, and shortcuts to the dashboard and the quota tracker.
+ * The router object (state and start/stop) lives in AiChat.qml.
+ */
+Rectangle {
+    id: root
+    property bool shown: false
+    property var router: NineRouter
+    property bool showClose: true // The 9router tab has no panel to close
+
+    visible: shown
+    color: Appearance.colors.colLayer1Base // Solid, so the chat behind it never shows through
+    onShownChanged: {
+        if (!shown) return;
+        root.router.run("status", false);
+        Ai.refreshRouterUsage();
+    }
+
+    readonly property var today: Ai.routerUsage?.today
+    readonly property var savers: Ai.routerUsage?.savers ?? ({})
+
+    component SectionTitle: StyledText {
+        Layout.fillWidth: true
+        Layout.topMargin: 10
+        wrapMode: Text.Wrap
+        font.pixelSize: Appearance.font.pixelSize.small
+        color: Appearance.colors.colOnSurfaceVariant
+    }
+
+    component PanelButton: RippleButton {
+        id: panelButton
+        property string label
+        property string tooltip: ""
+        implicitHeight: 32
+        implicitWidth: panelButtonText.implicitWidth + 24
+        buttonRadius: height / 2
+        colBackground: Appearance.colors.colLayer3
+        colBackgroundHover: Appearance.colors.colLayer3Hover
+        colRipple: Appearance.colors.colLayer3Active
+        contentItem: StyledText {
+            id: panelButtonText
+            horizontalAlignment: Text.AlignHCenter
+            verticalAlignment: Text.AlignVCenter
+            font.pixelSize: Appearance.font.pixelSize.small
+            color: Appearance.colors.colOnLayer2
+            text: panelButton.label
+        }
+        StyledToolTip {
+            extraVisibleCondition: panelButton.tooltip.length > 0
+            text: panelButton.tooltip
+        }
+    }
+
+    component InfoRow: Rectangle {
+        id: infoRow
+        property string label
+        property string value
+        Layout.fillWidth: true
+        implicitHeight: infoRowLayout.implicitHeight + 16
+        radius: Appearance.rounding.small
+        color: Appearance.colors.colLayer2
+        RowLayout {
+            id: infoRowLayout
+            anchors {
+                left: parent.left
+                right: parent.right
+                verticalCenter: parent.verticalCenter
+                margins: 10
+            }
+            spacing: 10
+            StyledText {
+                color: Appearance.colors.colOnLayer1
+                text: infoRow.label
+            }
+            StyledText {
+                Layout.fillWidth: true
+                horizontalAlignment: Text.AlignRight
+                wrapMode: Text.Wrap
+                textFormat: Text.PlainText
+                font.pixelSize: Appearance.font.pixelSize.smaller
+                color: Appearance.colors.colOnSurfaceVariant
+                text: infoRow.value
+            }
+        }
+    }
+
+    StyledFlickable {
+        anchors.fill: parent
+        anchors.margins: 12
+        clip: true
+        contentHeight: panelColumn.implicitHeight
+
+        ColumnLayout {
+            id: panelColumn
+            width: parent.width
+            spacing: 6
+
+            RowLayout {
+                Layout.fillWidth: true
+                StyledText {
+                    Layout.fillWidth: true
+                    font.pixelSize: Appearance.font.pixelSize.larger
+                    color: Appearance.colors.colOnLayer1
+                    text: Translation.tr("9router")
+                }
+                PanelButton {
+                    visible: root.showClose
+                    label: Translation.tr("Close")
+                    onClicked: root.shown = false
+                }
+            }
+
+            Rectangle { // The switch
+                Layout.fillWidth: true
+                implicitHeight: switchRow.implicitHeight + 16
+                radius: Appearance.rounding.small
+                color: Appearance.colors.colLayer2
+                RowLayout {
+                    id: switchRow
+                    anchors {
+                        left: parent.left
+                        right: parent.right
+                        verticalCenter: parent.verticalCenter
+                        margins: 10
+                    }
+                    spacing: 10
+                    ColumnLayout {
+                        Layout.fillWidth: true
+                        spacing: 0
+                        StyledText {
+                            color: Appearance.colors.colOnLayer1
+                            text: root.router.busy ? (root.router.action === "stop" ? Translation.tr("Stopping…") : Translation.tr("Starting…"))
+                                : root.router.running ? Translation.tr("On") : Translation.tr("Off")
+                        }
+                        StyledText {
+                            Layout.fillWidth: true
+                            wrapMode: Text.Wrap
+                            textFormat: Text.PlainText
+                            font.pixelSize: Appearance.font.pixelSize.smaller
+                            color: root.router.error.length > 0 ? Appearance.colors.colError : Appearance.colors.colOnSurfaceVariant
+                            text: root.router.error.length > 0 ? root.router.error
+                                : root.router.running ? Translation.tr("The local AI router is running at %1").arg(root.router.url)
+                                : Translation.tr("Stopped. Models that go through 9router don't work until it starts")
+                        }
+                    }
+                    StyledSwitch {
+                        id: routerSwitch
+                        enabled: !root.router.busy
+                        checked: root.router.running
+                        onClicked: {
+                            root.router.run(checked ? "start" : "stop", false);
+                            checked = Qt.binding(() => root.router.running); // The switch follows the real state, not the click
+                        }
+                        StyledToolTip {
+                            text: routerSwitch.checked ? Translation.tr("Click to stop 9router") : Translation.tr("Click to start 9router")
+                        }
+                    }
+                }
+            }
+
+            RowLayout {
+                spacing: 6
+                PanelButton {
+                    label: Translation.tr("Open dashboard")
+                    tooltip: Translation.tr("Opens 9router's dashboard in the browser")
+                    enabled: root.router.running
+                    onClicked: Qt.openUrlExternally(`${root.router.url}/dashboard`)
+                }
+                PanelButton {
+                    label: Translation.tr("Quota tracker")
+                    tooltip: Translation.tr("Posts each account's limits and resets in the chat, like /usage")
+                    enabled: root.router.running
+                    onClicked: {
+                        Ai.showQuotaTracker();
+                        root.shown = false;
+                    }
+                }
+            }
+
+            SectionTitle {
+                visible: root.router.running && root.today !== undefined
+                text: Translation.tr("Today")
+            }
+            InfoRow {
+                visible: root.router.running && root.today !== undefined
+                label: Translation.tr("Requests")
+                value: `${root.today?.requests ?? 0}`
+            }
+            InfoRow {
+                visible: root.router.running && root.today !== undefined
+                label: Translation.tr("Tokens")
+                value: Translation.tr("%1 sent · %2 written").arg(Ai.shortTokens(root.today?.promptTokens ?? 0)).arg(Ai.shortTokens(root.today?.completionTokens ?? 0))
+            }
+            InfoRow {
+                visible: root.router.running && Object.keys(root.today?.byProvider ?? {}).length > 0
+                label: Translation.tr("By provider")
+                value: Object.entries(root.today?.byProvider ?? {}).sort(([, a], [, b]) => b.requests - a.requests)
+                    .map(([name, provider]) => `${name} ${provider.requests}`).join(" · ")
+            }
+
+            SectionTitle {
+                visible: root.today !== undefined
+                text: Translation.tr("Token savers")
+            }
+            InfoRow {
+                visible: root.today !== undefined
+                label: Translation.tr("On")
+                value: Object.entries(root.savers).filter(([, on]) => on).map(([name]) => name).join(", ") || Translation.tr("none")
+            }
+        }
+    }
+}
