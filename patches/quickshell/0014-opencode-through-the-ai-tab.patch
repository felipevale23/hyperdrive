+++ b/services/ai/OpenCodeApiStrategy.qml
@@ -0,0 +1,109 @@
+import QtQuick
+
+/**
+ * Talks to OpenCode through the opencode-tab helper, which prints one JSON event per line.
+ * OpenCode keeps the conversation in a session, so only the newest message is sent.
+ * Tools are off: the helper refuses any session without its deny rule.
+ */
+ApiStrategy {
+    property string helperPath: ""
+    property string sessionId: ""
+    property string pendingText: ""
+    property string pendingModel: ""
+    property bool fileSkipped: false
+    property bool isReasoning: false
+    property bool hasText: false
+
+    function buildEndpoint(model: AiModel): string {
+        return model.endpoint;
+    }
+
+    function buildRequestData(model: AiModel, messages, systemPrompt: string, temperature: real, tools: list<var>, filePath: string) {
+        const userMessages = messages.filter(message => message.role === "user");
+        pendingText = userMessages.length > 0 ? userMessages[userMessages.length - 1].rawContent : "";
+        pendingModel = model.model;
+        fileSkipped = filePath.length > 0;
+        return {};
+    }
+
+    function buildAuthorizationHeader(apiKeyEnvVarName: string): string {
+        return "";
+    }
+
+    function shellQuote(text) {
+        return `'${text.replace(/'/g, "'\\''")}'`;
+    }
+
+    // The request is the helper, not curl. The message goes on stdin, so it has no size
+    // limit and stays out of the process list. exec lets the stop button reach the helper.
+    function finalizeScriptContent(scriptContent: string): string {
+        let delimiter = "OPENCODE_TAB_END";
+        while (pendingText.includes(delimiter)) delimiter += "_X";
+        return "#!/usr/bin/env bash\n"
+            + `exec ${shellQuote(helperPath)} send ${shellQuote(pendingModel)} ${shellQuote(sessionId)} <<'${delimiter}'\n`
+            + `${pendingText}\n${delimiter}\n`;
+    }
+
+    function add(message, text) {
+        message.content += text;
+        message.rawContent += text;
+    }
+
+    function endReasoning(message) {
+        if (!isReasoning) return;
+        isReasoning = false;
+        add(message, "\n\n</think>\n\n");
+    }
+
+    function parseResponseLine(line, message) {
+        const event = JSON.parse(line);
+        if (fileSkipped) {
+            fileSkipped = false;
+            add(message, `_${qsTr("The attached file was not sent: OpenCode models do not take attachments here yet.")}_\n\n`);
+        }
+        switch (event.type) {
+        case "session":
+            sessionId = event.id;
+            return {};
+        case "reasoning":
+            if (!isReasoning) {
+                isReasoning = true;
+                add(message, "\n\n<think>\n\n");
+            }
+            add(message, event.delta);
+            return {};
+        case "text":
+            endReasoning(message);
+            hasText = true;
+            add(message, event.delta);
+            return {};
+        case "usage": {
+            const input = event.tokens?.input ?? -1;
+            const output = event.tokens?.output ?? -1;
+            return { tokenUsage: { input: input, output: output, total: input + output } };
+        }
+        case "succeeded":
+            endReasoning(message);
+            if (!hasText) add(message, `_${qsTr("The model finished without writing a reply.")}_`);
+            return { finished: true };
+        case "interrupted":
+            endReasoning(message);
+            if (!hasText) add(message, `_${qsTr("Stopped.")}_`);
+            return { finished: true };
+        case "failed":
+            endReasoning(message);
+            add(message, `**${qsTr("Error")}**: ${event.error}`);
+            return { finished: true };
+        }
+        return {};
+    }
+
+    function reset() {
+        isReasoning = false;
+        hasText = false;
+    }
+
+    function newSession() {
+        sessionId = "";
+    }
+}
