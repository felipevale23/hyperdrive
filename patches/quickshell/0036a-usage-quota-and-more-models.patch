+    function quotaReset(iso) {
+        if (!iso) return "–";
+        const minutes = Math.round((new Date(iso).getTime() - Date.now()) / 60000);
+        if (isNaN(minutes)) return "–";
+        if (minutes <= 0) return Translation.tr("now");
+        if (minutes < 120) return Translation.tr("in %1 min").arg(minutes);
+        if (minutes < 48 * 60) return Translation.tr("in %1 h").arg(Math.round(minutes / 60));
+        return Translation.tr("in %1 days").arg(Math.round(minutes / 1440));
+    }
+    function quotaTable(connections) {
