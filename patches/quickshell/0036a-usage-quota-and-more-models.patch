+        const rows = [];
+        for (const conn of connections) {
+            const account = `${conn.provider} · ${conn.name}`;
+            if (conn.quotas.length === 0) {
+                rows.push(`| ${account} | ${conn.error ?? conn.message ?? "–"} | | | |`);
+                continue;
+            }
+            for (const quota of conn.quotas) {
+                const left = quota.remaining ?? (quota.total > 0 ? 100 * (1 - quota.used / quota.total) : null);
