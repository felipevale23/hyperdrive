+            }
+        }
+        return `${Translation.tr("Quota tracker (9router)")}\n\n| ${Translation.tr("Account")} | ${Translation.tr("Limit")} | ${Translation.tr("Used")} | ${Translation.tr("Left")} | ${Translation.tr("Resets")} |\n|---|---|---|---|---|\n${rows.join("\n")}`;
