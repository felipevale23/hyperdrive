+    // The local 9router (decolua/9router). ~/.local/bin/9router-ctl starts and stops it and
+    // prints its state as JSON. It listens on 127.0.0.1 only and nothing starts it on boot.
+    QtObject {
+        id: router
+        property bool running: false
+        property bool busy: false
+        property string error: ""
+        property string url: "http://127.0.0.1:20128"
+        property bool report: false // Say the result in the chat, for /router
+        property string action: ""
+        function run(what, reportIt) {
+            if (routerProc.running) return;
+            router.action = what;
+            router.report = reportIt;
+            router.busy = what !== "status";
+            routerProc.command = [`${Quickshell.env("HOME")}/.local/bin/9router-ctl`, what];
+            routerProc.running = true;
+        }
+    }
+
+    Process {
+        id: routerProc
+        stdout: StdioCollector {
+            id: routerOut
+            onStreamFinished: {
+                let state = {};
+                try {
+                    state = JSON.parse(routerOut.text);
+                } catch (e) {
+                    state = { "running": false, "error": Translation.tr("9router-ctl gave no answer") };
+                }
+                router.running = state.running === true;
+                router.error = state.error ?? "";
+                if (state.url) router.url = state.url;
+                router.busy = false;
+                if (!router.report) return;
+                const message = router.error.length > 0 ? Translation.tr("9router: %1").arg(router.error)
+                    : router.running ? Translation.tr("9router is running at %1. Its dashboard: %2router open").arg(router.url).arg(root.commandPrefix)
+                    : Translation.tr("9router is stopped");
+                Ai.addMessage(message, Ai.interfaceRole);
+            }
+        }
+        onExited: (exitCode, exitStatus) => {
+            if (exitCode !== 0 && routerOut.text.length === 0) {
+                router.busy = false;
+                router.running = false;
+                router.error = Translation.tr("9router-ctl failed (exit %1)").arg(exitCode);
+            }
+        }
+    }
+
+    Timer { // Notices a stop from elsewhere, only while the sidebar shows
+        interval: 15000
+        repeat: true
+        triggeredOnStart: true
+        running: GlobalStates.sidebarLeftOpen
+        onTriggered: if (!router.busy) router.run("status", false)
+    }
+
     Process {
