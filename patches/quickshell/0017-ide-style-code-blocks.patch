+
+    // Measured from the real layout, so diff rows and numbers stay right on wrapped lines
+    property var lineRows: []
+    function measureLines() {
+        if (!root.isDiff && !root.isPermissionCard) {
+            root.lineRows = [];
+            return;
+        }
+        let offset = 0;
+        root.lineRows = codeTextArea.text.split("\n").map(line => {
+            const start = codeTextArea.positionToRectangle(offset);
+            const end = codeTextArea.positionToRectangle(offset + line.length);
+            offset += line.length + 1;
+            return { y: start.y, height: end.y + end.height - start.y, line: line };
+        });
+    }
+    function diffColor(line) {
+        if (line.startsWith("+") && !line.startsWith("+++")) return Qt.rgba(0.31, 0.98, 0.48, 0.14);
+        if (line.startsWith("-") && !line.startsWith("---")) return Qt.rgba(1, 0.33, 0.33, 0.16);
+        if (line.startsWith("@@")) return Qt.rgba(0.55, 0.91, 0.99, 0.10);
+        return "transparent";
+    }
 
