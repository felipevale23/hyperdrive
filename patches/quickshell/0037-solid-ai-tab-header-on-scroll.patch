+                onWheel: (event) => {
+                    const dy = event.pixelDelta.y !== 0 ? event.pixelDelta.y : event.angleDelta.y / 120 * 60;
+                    if (Math.abs(event.angleDelta.x) > Math.abs(event.angleDelta.y) || dy === 0) {
+                        event.accepted = false;
+                        return;
+                    }
+                    const list = root.outerList();
+                    if (!list) {
+                        event.accepted = false;
+                        return;
+                    }
+                    const top = list.originY ?? 0;
+                    const maxY = Math.max(top, top + list.contentHeight - list.height);
+                    list.contentY = Math.max(top, Math.min(list.contentY - dy, maxY));
+                    event.accepted = true;
+                }
