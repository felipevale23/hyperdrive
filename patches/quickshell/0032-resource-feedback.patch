+    // OpenCode usage for the chat on screen: tokens processed so far, and how full the context is
+    property real opencodeChatTokens: 0
+    property var opencodeContext: null // { used, limit } from the last turn
+    // Today's 9router numbers and token savers, from 9router-ctl usage. Null until read
+    property var routerUsage: null
+    function refreshRouterUsage() {
+        if (!routerUsageProc.running) routerUsageProc.running = true;
+    }
+    Process {
+        id: routerUsageProc
+        command: [`${Quickshell.env("HOME")}/.local/bin/9router-ctl`, "usage"]
+        stdout: StdioCollector {
+            id: routerUsageOut
+            onStreamFinished: {
+                try {
+                    root.routerUsage = JSON.parse(routerUsageOut.text);
+                } catch (e) {
+                    root.routerUsage = null;
+                }
+            }
+        }
+    }
+
+    Process { // Reads a resumed chat's totals; separate from opencodeCommand, which is still finishing
+        id: opencodeUsageProc
+        stdout: StdioCollector {
+            id: opencodeUsageOut
+            onStreamFinished: {
+                try {
+                    const reply = JSON.parse(opencodeUsageOut.text);
+                    if (!reply.ok) return;
+                    root.opencodeChatTokens = reply.result.total;
+                    root.opencodeContext = reply.result.context;
+                } catch (e) {}
+            }
+        }
+    }
+
+    function tokensProcessed(entry) {
+        return (entry.input ?? 0) + (entry.cache ?? 0) + (entry.output ?? 0) + (entry.reasoning ?? 0);
+    }
+    function shortTokens(count) {
+        return root.apiStrategies.opencode.shortTokens(Math.round(count));
+    }
+
+    // /usage: this chat's tokens by agent and model, context fill, the budget, and 9router today
+    function showOpencodeUsage() {
+        const session = opencodeSessionOrAdvice();
+        if (session.length === 0) return;
+        root.refreshRouterUsage();
+        runOpencode(["usage", session], usage => {
+            root.opencodeChatTokens = usage.total;
+            if (usage.context) root.opencodeContext = usage.context;
+            const rows = usage.agents.map(entry => `| ${entry.agent} | ${entry.model.split("/").pop()} | ${entry.steps} | ${root.shortTokens(entry.input + entry.cache)} | ${root.shortTokens(entry.cache)} | ${root.shortTokens(entry.output + entry.reasoning)} | ${root.shortTokens(root.tokensProcessed(entry))} |`);
+            const context = usage.context?.limit
+                ? Translation.tr("Context: %1 of %2 (%3%)").arg(root.shortTokens(usage.context.used)).arg(root.shortTokens(usage.context.limit)).arg(Math.round(100 * usage.context.used / usage.context.limit))
+                : Translation.tr("Context: not known yet");
+            const budget = usage.budget > 0 ? Translation.tr("Budget: a warning past %1 tokens in one turn").arg(root.shortTokens(usage.budget)) : Translation.tr("Budget: off");
+            const router = root.routerUsage?.today ? root.routerSummary() : "";
+            root.addMessage(`${Translation.tr("Tokens in this chat, over %1 turns: %2").arg(usage.turns).arg(root.shortTokens(usage.total))}\n\n`
+                + `| ${Translation.tr("Agent")} | ${Translation.tr("Model")} | ${Translation.tr("Steps")} | ${Translation.tr("Sent")} | ${Translation.tr("Of it cached")} | ${Translation.tr("Written")} | ${Translation.tr("Total")} |\n|---|---|---|---|---|---|---|\n`
+                + `${rows.join("\n")}\n\n${context}. ${budget}.${router.length > 0 ? `\n\n${router}` : ""}`, root.interfaceRole);
+        });
+    }
+
+    // One paragraph on 9router today, for /usage and the 9router chip
+    function routerSummary() {
+        const today = root.routerUsage?.today;
+        if (!today) return "";
+        const providers = Object.entries(today.byProvider ?? {}).map(([name, p]) => `${name} ${p.requests}`).join(", ");
+        const savers = Object.entries(root.routerUsage.savers ?? {}).filter(([, on]) => on).map(([name]) => name).join(", ");
+        return Translation.tr("9router today: %1 requests (%2), %3 tokens sent, %4 written. Token savers on: %5. RTK shrank %6 tool results since 9router started.")
+            .arg(today.requests ?? 0).arg(providers || "none").arg(root.shortTokens(today.promptTokens ?? 0))
+            .arg(root.shortTokens(today.completionTokens ?? 0)).arg(savers || "none").arg(root.routerUsage.rtkHits ?? 0);
+    }
+
+    // /usage budget TOKENS: when a turn warns, 0 for never
+    function setOpencodeBudget(value) {
+        runOpencode(["team-set", "budget", String(value ?? "")], team => {
+            root.addMessage(team.budget > 0 ? Translation.tr("A turn now warns past %1 tokens").arg(root.shortTokens(team.budget)) : Translation.tr("Token budget warning is off"), root.interfaceRole);
+        });
+    }
+
     function clearMessages() {
+        root.opencodeChatTokens = 0;
+        root.opencodeContext = null;
         root.messageIDs = [];
         root.messageByID = ({});
         root.tokenCount.input = -1;
