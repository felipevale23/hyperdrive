+import qs.modules.common
+import qs.modules.common.widgets
+import qs.services
+import QtQuick
+import QtQuick.Layouts
+
+/**
+ * What the models know about your work, in one place: the project folder (and a new one from
+ * scratch), its AGENTS.md instructions, the facts every new chat starts with, and the skills found.
+ * Two buttons ask the model to learn from the chat. Everything it shows is plain text, because it
+ * comes from files a model can write.
+ */
+Rectangle {
+    id: root
+    property bool shown: false
+    property var info: null // From opencode-tab project-info: folder, instructions, skills
+    property var facts: []
+    property var knownFolders: []
+    property var grants: [] // Files and folders models may always read
+    property string panelError: ""
+    readonly property int factLimit: 50
+
+    readonly property string folder: root.info?.folder ?? (Ai.opencodeFolder.length > 0 ? Ai.opencodeFolder : "~/.agents")
+    readonly property string savedInstructions: root.info?.instructions ?? ""
+    readonly property bool dirty: instructionsField.text !== root.savedInstructions
+
+    visible: shown
+    color: Appearance.colors.colLayer1Base // Solid, so the chat behind it never shows through
+    onShownChanged: {
+        if (shown) refresh();
+    }
+
+    // One helper process at a time, so each step starts the next
+    function refresh() {
+        root.panelError = "";
+        Ai.runAgentTool(["project-info", Ai.opencodeFolder], info => {
+            root.info = info;
