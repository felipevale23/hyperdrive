+pragma Singleton
+pragma ComponentBehavior: Bound
+
+import Quickshell
+import Quickshell.Io
+import QtQuick
+
+/**
+ * The local 9router (decolua/9router). ~/.local/bin/9router-ctl starts and stops it and prints its
+ * state as JSON. It listens on 127.0.0.1 only and nothing starts it on boot. One copy of the state,
+ * shared by the AI tab's chip and the 9router tab.
+ */
+Singleton {
+    id: root
+    property bool running: false
+    property bool busy: false
+    property string error: ""
+    property string url: "http://127.0.0.1:20128"
+    property bool report: false // Say the result in the chat, for /router
+    property string action: ""
+    signal finished(bool report) // After each run, once the state above is updated
+
+    // Headroom, the context-compressing proxy 9router calls (9router-ctl headroom ...)
+    property bool headroomRunning: false
+    property bool headroomBusy: false
+    property string headroomVersion: ""
+    property string headroomError: ""
+    property string headroomAction: ""
+    function runHeadroom(what) {
+        if (headroomProc.running) return;
+        root.headroomAction = what;
+        root.headroomBusy = what !== "status";
+        headroomProc.command = [`${Quickshell.env("HOME")}/.local/bin/9router-ctl`, "headroom", what];
+        headroomProc.running = true;
+    }
+
+    function run(what, reportIt) {
+        if (routerProc.running) return;
+        root.action = what;
+        root.report = reportIt;
+        root.busy = what !== "status";
+        routerProc.command = [`${Quickshell.env("HOME")}/.local/bin/9router-ctl`, what];
+        routerProc.running = true;
+    }
+
+    Process {
+        id: headroomProc
+        stdout: StdioCollector {
+            id: headroomOut
+            onStreamFinished: {
+                let state = {};
+                try {
+                    state = JSON.parse(headroomOut.text);
+                } catch (e) {
+                    state = { "running": false, "error": Translation.tr("9router-ctl gave no answer") };
+                }
+                root.headroomRunning = state.running === true;
+                root.headroomVersion = state.version ?? "";
+                root.headroomError = state.error ?? "";
+                root.headroomBusy = false;
+            }
+        }
+        onExited: (exitCode, exitStatus) => {
+            if (exitCode !== 0 && headroomOut.text.length === 0) {
+                root.headroomBusy = false;
+                root.headroomRunning = false;
+                root.headroomError = Translation.tr("9router-ctl failed (exit %1)").arg(exitCode);
+            }
+        }
+    }
+
+    Process {
+        id: routerProc
+        stdout: StdioCollector {
+            id: routerOut
+            onStreamFinished: {
+                let state = {};
+                try {
+                    state = JSON.parse(routerOut.text);
+                } catch (e) {
+                    state = { "running": false, "error": Translation.tr("9router-ctl gave no answer") };
+                }
+                root.running = state.running === true;
+                root.error = state.error ?? "";
+                if (state.url) root.url = state.url;
+                root.busy = false;
+                root.finished(root.report);
+            }
+        }
+        onExited: (exitCode, exitStatus) => {
+            if (exitCode !== 0 && routerOut.text.length === 0) {
+                root.busy = false;
+                root.running = false;
+                root.error = Translation.tr("9router-ctl failed (exit %1)").arg(exitCode);
+            }
+        }
+    }
+}
