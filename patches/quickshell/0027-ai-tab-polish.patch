+    /**
+     * Drops the "Index:" and "=====" lines some tools put above a unified diff. Display only:
+     * /undo needs the recorded patch whole, so never store the result.
+     * @param { string } patch
+     * @returns { string }
+     */
+    function cleanDiff(patch) {
+        return (patch ?? "").split("\n").filter(line => !/^Index: /.test(line) && !/^={3,}\s*$/.test(line)).join("\n");
+    }
+
+    /**
+     * The file a unified diff changes and its added and removed line counts.
+     * @param { string } patch
+     * @returns {{file: string, added: number, removed: number}}
+     */
+    function diffSummary(patch) {
+        let file = "", added = 0, removed = 0;
+        for (const line of (patch ?? "").split("\n")) {
+            if (line.startsWith("+++ ") || line.startsWith("--- ")) {
+                // "+++ b/path\ttimestamp"; a deleted file's "+++" is /dev/null, so keep the "---" name then
+                const name = line.slice(4).split("\t")[0].trim().replace(/^[ab]\//, "");
+                if (name !== "/dev/null" && (file === "" || line.startsWith("+++ "))) file = name;
+            } else if (line.startsWith("+")) added++;
+            else if (line.startsWith("-")) removed++;
+        }
+        return { "file": file, "added": added, "removed": removed };
+    }
+
