diff --git a/modules/ii/sidebarLeft/aiChat/MessageSubagentRow.qml b/modules/ii/sidebarLeft/aiChat/MessageSubagentRow.qml
new file mode 100644
index 0000000..b19c1d1
--- /dev/null
+++ b/modules/ii/sidebarLeft/aiChat/MessageSubagentRow.qml
@@ -0,0 +1,101 @@
+import qs.services
+import qs.modules.common
+import qs.modules.common.widgets
+import QtQuick
+import QtQuick.Layouts
+
+/**
+ * One subagent, live: its robot, its job and how it's going. Plain text, because the task comes from the model.
+ */
+Rectangle {
+    id: root
+    property var agent: ({})
+    readonly property string name: agent.name ?? ""
+    readonly property string stateText: {
+        switch (agent.state) {
+        case "waiting": return Translation.tr("Waiting for you");
+        case "done": return Translation.tr("Done");
+        case "failed": return Translation.tr("Failed");
+        case "stopped": return Translation.tr("Stopped");
+        }
+        return Translation.tr("Working");
+    }
+    readonly property string details: {
+        if (agent.activity?.length > 0) return `${agent.activity}…`;
+        const parts = [];
+        if (agent.model?.length > 0) parts.push(agent.model.split("/").pop());
+        if (agent.tokens > 0) parts.push(Translation.tr("%1 tokens").arg(agent.tokens));
+        return parts.join(", ");
+    }
+
+    Layout.fillWidth: true
+    Layout.topMargin: 2
+    Layout.bottomMargin: 2
+    implicitHeight: Math.max(robot.implicitHeight, textColumn.implicitHeight) + 8 * 2
+    radius: Appearance.rounding.small
+    color: Appearance.colors.colLayer2
+    Accessible.name: `${root.name}: ${root.stateText}. ${root.agent.task ?? ""}`
+
+    RowLayout {
+        anchors {
+            left: parent.left
+            right: parent.right
+            verticalCenter: parent.verticalCenter
+            leftMargin: 10
+            rightMargin: 12
+        }
+        spacing: 12
+
+        PixelRobot {
+            id: robot
+            Layout.alignment: Qt.AlignVCenter
+            kind: root.name === "general" || root.name === "explore" ? root.name : "other"
+            state: root.agent.state ?? "running"
+        }
+
+        ColumnLayout {
+            id: textColumn
+            Layout.fillWidth: true
+            spacing: 1
+
+            RowLayout {
+                Layout.fillWidth: true
+                spacing: 8
+                StyledText {
+                    Layout.fillWidth: true
+                    textFormat: Text.PlainText
+                    elide: Text.ElideRight
+                    font.pixelSize: Appearance.font.pixelSize.small
+                    font.weight: Font.DemiBold
+                    color: Appearance.colors.colOnLayer2
+                    text: root.name.length > 0 ? root.name.charAt(0).toUpperCase() + root.name.slice(1) : Translation.tr("Subagent")
+                }
+                StyledText {
+                    font.pixelSize: Appearance.font.pixelSize.smaller
+                    color: Appearance.colors.colOnSurfaceVariant
+                    text: root.stateText
+                }
+            }
+            StyledText { // The job it was given
+                visible: text.length > 0
+                Layout.fillWidth: true
+                textFormat: Text.PlainText
+                wrapMode: Text.Wrap
+                maximumLineCount: 2
+                elide: Text.ElideRight
+                font.pixelSize: Appearance.font.pixelSize.smaller
+                color: Appearance.colors.colOnSurfaceVariant
+                text: root.agent.task ?? ""
+            }
+            StyledText { // What it's doing now, or what it used
+                visible: text.length > 0
+                Layout.fillWidth: true
+                textFormat: Text.PlainText
+                elide: Text.ElideMiddle
+                font.pixelSize: Appearance.font.pixelSize.smaller
+                color: Appearance.colors.colOnSurfaceVariant
+                text: root.details
+            }
+        }
+    }
+}
diff --git a/modules/ii/sidebarLeft/aiChat/PixelRobot.qml b/modules/ii/sidebarLeft/aiChat/PixelRobot.qml
new file mode 100644
index 0000000..2b8eba9
--- /dev/null
+++ b/modules/ii/sidebarLeft/aiChat/PixelRobot.qml
@@ -0,0 +1,192 @@
+import qs.modules.common
+import QtQuick
+
+/**
+ * A small pixel art robot, one kind per subagent type, drawn from the sprites below in theme colours.
+ * A 14 by 14 grid plus one row above for the question mark. It only animates while it has something to show.
+ * O outline, B body, H highlight, D shade, F face, A antenna.
+ */
+Canvas {
+    id: root
+    property string kind: "general"
+    property string state: "running" // running, waiting, done, failed or stopped
+    property int pixel: 3
+    property int frame: 0
+
+    readonly property var sprite: sprites[kind] ?? sprites["other"]
+    readonly property bool active: state === "running" || state === "waiting"
+    readonly property bool off: state === "failed" || state === "stopped"
+    readonly property color colBody: off ? Appearance.colors.colOutline
+        : (kind === "general" ? Appearance.m3colors.m3primary : (kind === "explore" ? Appearance.m3colors.m3tertiary : Appearance.m3colors.m3secondary))
+    readonly property color colEye: off ? Appearance.colors.colError : Appearance.colors.colOnLayer1
+
+    readonly property var sprites: ({
+        "general": {
+            "eyes": [[4, 6], [8, 6]],
+            "eyeSize": 2,
+            "frames": [[
+                "......AA......",
+                "......OO......",
+                "..OOOOOOOOOO..",
+                ".OBBBBBBBBBBO.",
+                ".OBHHHHHHHHBO.",
+                ".OBFFFFFFFFBO.",
+                ".OBFFFFFFFFBO.",
+                ".OBFFFFFFFFBO.",
+                ".OBFFFFFFFFBO.",
+                ".OBBBBBBBBBBO.",
+                "..OOOOOOOOOO..",
+                "OO.OBDDDDBO.OO",
+                "OB.OBBBBBBO.BO",
+                "...OO....OO..."],
+                [
+                "......AA......",
+                "......OO......",
+                "..OOOOOOOOOO..",
+                ".OBBBBBBBBBBO.",
+                ".OBHHHHHHHHBO.",
+                ".OBFFFFFFFFBO.",
+                ".OBFFFFFFFFBO.",
+                ".OBFFFFFFFFBO.",
+                ".OBFFFFFFFFBO.",
+                ".OBBBBBBBBBBO.",
+                "OBOOOOOOOOOOBO",
+                "OO.OBDDDDBO.OO",
+                "...OBBBBBBO...",
+                "...OO....OO..."]]
+        },
+        "explore": {
+            "eyes": [[5, 6]],
+            "eyeSize": 4,
+            "frames": [[
+                "...AAAAAAAA...",
+                "......OO......",
+                "....OOOOOO....",
+                "...OBHHHHBO...",
+                "..OBBBBBBBBO..",
+                ".OBFFFFFFFFBO.",
+                ".OBFFFFFFFFBO.",
+                ".OBFFFFFFFFBO.",
+                ".OBFFFFFFFFBO.",
+                "..OBBBBBBBBO..",
+                "...ODDDDDDO...",
+                "....OOOOOO....",
+                ".....O..O.....",
+                "....OO..OO...."],
+                [
+                ".....AAAA.....",
+                "......OO......",
+                "....OOOOOO....",
+                "...OBHHHHBO...",
+                "..OBBBBBBBBO..",
+                ".OBFFFFFFFFBO.",
+                ".OBFFFFFFFFBO.",
+                ".OBFFFFFFFFBO.",
+                ".OBFFFFFFFFBO.",
+                "..OBBBBBBBBO..",
+                "...ODDDDDDO...",
+                "....OOOOOO....",
+                "......OO......",
+                ".....OOOO....."]]
+        },
+        "other": {
+            "eyes": [[4, 6], [8, 6]],
+            "eyeSize": 2,
+            "frames": [[
+                ".A..........A.",
+                ".O..........O.",
+                ".OOOOOOOOOOOO.",
+                ".OBHHHHHHHHBO.",
+                ".OBBBBBBBBBBO.",
+                ".OBFFFFFFFFBO.",
+                ".OBFFFFFFFFBO.",
+                ".OBFFFFFFFFBO.",
+                ".OBFFFFFFFFBO.",
+                ".OBBBBBBBBBBO.",
+                ".OOOOOOOOOOOO.",
+                "...OBDDDDBO...",
+                ".OOOOOOOOOOOO.",
+                ".ODODODODODOD."],
+                [
+                ".A..........A.",
+                ".O..........O.",
+                ".OOOOOOOOOOOO.",
+                ".OBHHHHHHHHBO.",
+                ".OBBBBBBBBBBO.",
+                ".OBFFFFFFFFBO.",
+                ".OBFFFFFFFFBO.",
+                ".OBFFFFFFFFBO.",
+                ".OBFFFFFFFFBO.",
+                ".OBBBBBBBBBBO.",
+                ".OOOOOOOOOOOO.",
+                "...OBDDDDBO...",
+                ".OOOOOOOOOOOO.",
+                ".DODODODODODO."]]
+        }
+    })
+
+    implicitWidth: 14 * pixel
+    implicitHeight: 15 * pixel
+    onFrameChanged: requestPaint()
+    onStateChanged: requestPaint()
+    onColBodyChanged: requestPaint()
+    onColEyeChanged: requestPaint()
+    onKindChanged: requestPaint()
+
+    Timer {
+        running: root.active && root.visible
+        interval: 450
+        repeat: true
+        onTriggered: root.frame = 1 - root.frame
+    }
+
+    onPaint: {
+        const ctx = getContext("2d");
+        ctx.clearRect(0, 0, width, height);
+        const dot = (x, y, color) => {
+            ctx.fillStyle = color;
+            ctx.fillRect(x * pixel, (y + 1) * pixel, pixel, pixel);
+        };
+        const colors = {
+            "O": Qt.darker(colBody, 2),
+            "B": colBody,
+            "H": Qt.lighter(colBody, 1.25),
+            "D": Qt.darker(colBody, 1.4),
+            "F": Appearance.colors.colLayer0,
+            "A": state === "waiting" ? Appearance.colors.colError : Qt.lighter(colBody, 1.4),
+        };
+        const rows = sprite.frames[state === "running" ? frame : 0];
+        rows.forEach((row, y) => {
+            for (let x = 0; x < row.length; x++) {
+                if (colors[row[x]]) dot(x, y, colors[row[x]]);
+            }
+        });
+        const size = sprite.eyeSize;
+        sprite.eyes.forEach(eye => {
+            const ex = eye[0];
+            const ey = eye[1];
+            if (off) {
+                for (let i = 0; i < size; i++) dot(ex + i, ey + 1, colEye);
+            } else if (state === "done") {
+                dot(ex, ey + 1, colEye);
+                dot(ex + size - 1, ey + 1, colEye);
+                for (let i = 1; i < size - 1; i++) dot(ex + i, ey, colEye);
+                if (size === 2) dot(ex + 1, ey, colEye);
+            } else if (state === "waiting") {
+                for (let i = 0; i < size; i++) {
+                    dot(ex + i, ey - 1, colEye);
+                    dot(ex + i, ey, colEye);
+                }
+            } else { // Looking around
+                const shift = size === 2 ? -frame : frame * 2;
+                for (let i = 0; i < 2; i++) {
+                    dot(ex + i + shift, ey, colEye);
+                    dot(ex + i + shift, ey + 1, colEye);
+                }
+            }
+        });
+        if (state === "waiting") {
+            [[11, -1], [12, -1], [13, -1], [13, 0], [12, 1], [12, 3]].forEach(point => dot(point[0], point[1], colEye));
+        }
+    }
+}
