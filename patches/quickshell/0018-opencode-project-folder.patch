+    // Only ever called from a typed /project. A chat can't change folder, so this starts a new one.
+    function chooseOpencodeFolder(choice) {
+        if (choice.length === 0) {
+            runOpencode(["folders"], folders => {
+                root.opencodeFolders = folders;
+                const lines = folders.map((folder, i) => `${i + 1}. ${folder}`);
+                root.addMessage(`${Translation.tr("Project folders. Use /project NUMBER or /project PATH. This starts a new chat")}\n\n${lines.join("\n")}`, root.interfaceRole);
+            });
+            return;
+        }
+        const listed = /^\d+$/.test(choice) ? root.opencodeFolders[parseInt(choice) - 1] : choice;
+        if (!listed) {
+            root.addMessage(Translation.tr("Use /project first, then /project NUMBER"), root.interfaceRole);
+            return;
+        }
+        runOpencode(["check", listed], folder => {
+            root.clearMessages();
+            root.opencodeFolder = folder;
+            root.addMessage(Translation.tr("New chat in %1. Files here can be read without asking").arg(folder), root.interfaceRole);
+        });
+    }
