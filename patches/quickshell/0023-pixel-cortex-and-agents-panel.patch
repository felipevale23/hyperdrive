diff --git a/modules/common/widgets/PixelCortex.qml b/modules/common/widgets/PixelCortex.qml
new file mode 100644
index 0000000..92087d1
--- /dev/null
+++ b/modules/common/widgets/PixelCortex.qml
@@ -0,0 +1,80 @@
+import qs.modules.common
+import QtQuick
+
+/**
+ * The Material "neurology" brain, redrawn on an 18 by 18 grid so it matches the symbol it replaces.
+ * While thinking, light runs out from the middle of the brain, with sparks in the accent colour.
+ * With idleAnimation on, a slow pulse passes now and then. It's still otherwise, so long chats stay cheap.
+ */
+Canvas {
+    id: root
+    property color color: Appearance.colors.colOnLayer1
+    property bool thinking: false
+    property bool idleAnimation: false
+    property int pixel: 1
+    property int tick: 0
+
+    readonly property int wavePeriod: thinking ? 10 : 60
+    readonly property color colWave: Appearance.m3colors.m3primary
+    readonly property color colSpark: Appearance.m3colors.m3tertiary
+
+    readonly property var sprite: [
+        ".....###..###.....",
+        "....##########....",
+        "....##..##..##....",
+        "..####..##..####..",
+        ".#####..##..#####.",
+        "###.###.##.###.###",
+        "##......##......##",
+        "##......##......##",
+        "###.....##.....###",
+        "#####...##...#####",
+        "#####...##...#####",
+        "##......##......##",
+        "###..##.##.##..###",
+        ".######.##.######.",
+        "..####..##..####..",
+        "....##..##..##....",
+        "....##########....",
+        ".....###..###....."
+    ]
+
+    implicitWidth: sprite[0].length * pixel
+    implicitHeight: sprite.length * pixel
+    onTickChanged: requestPaint()
+    onThinkingChanged: {
+        tick = 0;
+        requestPaint();
+    }
+    onColorChanged: requestPaint()
+    onColWaveChanged: requestPaint()
+    onColSparkChanged: requestPaint()
+
+    Timer {
+        running: root.visible && (root.thinking || root.idleAnimation)
+        interval: root.thinking ? 90 : 160
+        repeat: true
+        onTriggered: root.tick = (root.tick + 1) % 600 // A multiple of both wave periods
+    }
+
+    onPaint: {
+        const ctx = getContext("2d");
+        ctx.clearRect(0, 0, width, height);
+        const middle = (sprite[0].length - 1) / 2;
+        const animated = thinking || idleAnimation;
+        sprite.forEach((row, y) => {
+            for (let x = 0; x < row.length; x++) {
+                if (row[x] !== "#") continue;
+                let colour = root.color;
+                if (animated) {
+                    const distance = Math.floor(Math.abs(x - middle));
+                    const wave = (distance - tick % wavePeriod + wavePeriod * 2) % wavePeriod;
+                    if (wave <= 1) colour = colWave;
+                    if (thinking && (x * 7 + y * 13 + tick * 5) % 37 === 0) colour = colSpark;
+                }
+                ctx.fillStyle = colour;
+                ctx.fillRect(x * pixel, y * pixel, pixel, pixel);
+            }
+        });
+    }
+}
