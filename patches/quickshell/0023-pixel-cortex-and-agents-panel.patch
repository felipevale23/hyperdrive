diff --git a/modules/ii/sidebarLeft/aiChat/AgentsPanel.qml b/modules/ii/sidebarLeft/aiChat/AgentsPanel.qml
new file mode 100644
index 0000000..d2fd814
--- /dev/null
+++ b/modules/ii/sidebarLeft/aiChat/AgentsPanel.qml
@@ -0,0 +1,454 @@
+import qs.modules.common
+import qs.modules.common.widgets
+import qs.services
+import QtQuick
+import QtQuick.Layouts
+
+/**
+ * Everything about agents in one place: which one answers, the subagents to call with @,
+ * the ones running in this chat, and a form for a new one. Agent text is plain text,
+ * because it comes from a model or an agent file.
+ */
+Rectangle {
+    id: root
+    property bool shown: false
+    property var inputField
+    property var chatAgents: []
+    property string openAgent: "" // Whose messages are showing
+    property string openText: ""
+    property bool formShown: false
+    property string formError: ""
+    property string panelError: ""
+    property string teamOpen: "" // The role whose model list is showing
+
+    function modelName(id) {
+        return (Ai.opencodeTeam.models ?? []).find(model => model.id === id)?.name ?? id ?? "";
+    }
+
+    readonly property var primaryAgents: Ai.opencodeAgents.filter(agent => agent.mode === "primary")
+    readonly property var subagents: Ai.opencodeAgents.filter(agent => agent.mode !== "primary")
+
+    visible: shown
+    color: Appearance.colors.colLayer1Base // Solid, so the chat behind it never shows through
+    onShownChanged: {
+        if (!shown) return;
+        Ai.refreshOpencodeAgents();
+        refreshChatAgents();
+    }
+
+    function refreshChatAgents() {
+        const list = [];
+        Ai.messageIDs.forEach(id => (Ai.messageByID[id]?.subagents ?? []).forEach(agent => list.push(agent)));
+        root.chatAgents = list.reverse();
+    }
+
+    function showMessages(agent) {
+        if (root.openAgent === agent.id) {
+            root.openAgent = "";
+            return;
+        }
+        root.openAgent = agent.id;
+        root.openText = Translation.tr("Loading…");
+        Ai.runAgentTool(["messages", agent.id], messages => {
+            root.openText = messages.map(item => `${item.role === "user" ? Translation.tr("Task") : Translation.tr("Reply")}:\n${item.text}`)
+                .join("\n\n") || Translation.tr("No messages yet");
+        }, error => root.openText = error);
+    }
+
+    function createAgent() {
+        root.formError = "";
+        Ai.runAgentTool(["agent-new", nameField.text.trim(), descriptionField.text, Ai.models[Ai.currentModelId]?.model ?? "", promptField.text], () => {
+            nameField.text = "";
+            descriptionField.text = "";
+            promptField.text = "";
+            root.formShown = false;
+            Ai.refreshOpencodeAgents();
+            Ai.reloadOpencodeServer();
+        }, error => root.formError = error);
+    }
+
+    Timer { // Keeps the running list live
+        running: root.shown
+        interval: 1000
+        repeat: true
+        onTriggered: root.refreshChatAgents()
+    }
+
+    component SectionTitle: StyledText {
+        Layout.fillWidth: true
+        Layout.topMargin: 10
+        wrapMode: Text.Wrap
+        font.pixelSize: Appearance.font.pixelSize.small
+        color: Appearance.colors.colSubtext
+    }
+
+    component AgentRow: RippleButton {
+        id: agentRow
+        property string name
+        property string description
+        property string kind: "other"
+        property bool selected: false
+        Layout.fillWidth: true
+        implicitHeight: agentRowContent.implicitHeight + 16
+        buttonRadius: Appearance.rounding.small
+        colBackground: selected ? Appearance.colors.colSecondaryContainer : Appearance.colors.colLayer2
+        colBackgroundHover: selected ? Appearance.colors.colSecondaryContainerHover : Appearance.colors.colLayer2Hover
+        colRipple: Appearance.colors.colLayer2Active
+        contentItem: RowLayout {
+            id: agentRowContent
+            anchors {
+                left: parent.left
+                right: parent.right
+                verticalCenter: parent.verticalCenter
+                margins: 10
+            }
+            spacing: 10
+            PixelRobot {
+                kind: agentRow.kind
+                state: "done"
+                pixel: 2
+            }
+            ColumnLayout {
+                Layout.fillWidth: true
+                spacing: 0
+                StyledText {
+                    Layout.fillWidth: true
+                    textFormat: Text.PlainText
+                    elide: Text.ElideRight
+                    color: Appearance.colors.colOnLayer1
+                    text: agentRow.name
+                }
+                StyledText {
+                    Layout.fillWidth: true
+                    textFormat: Text.PlainText
+                    wrapMode: Text.Wrap
+                    font.pixelSize: Appearance.font.pixelSize.smaller
+                    color: Appearance.colors.colOnSurfaceVariant
+                    text: agentRow.description
+                }
+            }
+        }
+    }
+
+    component TeamRow: Rectangle {
+        id: teamRow
+        property string role
+        property string label
+        property string hint
+        property string modelId
+        property bool canPick: true
+        property bool canSwitch: false
+        readonly property bool open: root.teamOpen === role
+        Layout.fillWidth: true
+        implicitHeight: teamRowColumn.implicitHeight + 16
+        radius: Appearance.rounding.small
+        color: Appearance.colors.colLayer2
+
+        ColumnLayout {
+            id: teamRowColumn
+            anchors {
+                left: parent.left
+                right: parent.right
+                top: parent.top
+                margins: 8
+            }
+            spacing: 6
+            RowLayout {
+                Layout.fillWidth: true
+                spacing: 8
+                ColumnLayout {
+                    Layout.fillWidth: true
+                    spacing: 0
+                    StyledText {
+                        Layout.fillWidth: true
+                        color: Appearance.colors.colOnLayer1
+                        text: teamRow.label
+                    }
+                    StyledText {
+                        Layout.fillWidth: true
+                        wrapMode: Text.Wrap
+                        font.pixelSize: Appearance.font.pixelSize.smaller
+                        color: Appearance.colors.colOnSurfaceVariant
+                        text: teamRow.hint
+                    }
+                }
+                StyledSwitch {
+                    visible: teamRow.canSwitch
+                    checked: Ai.opencodeTeam.advising ?? false
+                    onClicked: Ai.setOpencodeTeam("advising", checked ? "on" : "off", error => root.panelError = error)
+                }
+                PanelButton {
+                    label: root.modelName(teamRow.modelId)
+                    onClicked: {
+                        if (teamRow.canPick) root.teamOpen = teamRow.open ? "" : teamRow.role;
+                        else {
+                            root.inputField.text = "/model ";
+                            root.inputField.cursorPosition = root.inputField.text.length;
+                            root.inputField.forceActiveFocus();
+                            root.shown = false;
+                        }
+                    }
+                }
+            }
+            Flow {
+                visible: teamRow.open
+                Layout.fillWidth: true
+                spacing: 6
+                Repeater {
+                    model: Ai.opencodeTeam.models ?? []
+                    delegate: PanelButton {
+                        required property var modelData
+                        label: modelData.name
+                        onClicked: {
+                            Ai.setOpencodeTeam(teamRow.role, modelData.id, error => root.panelError = error);
+                            root.teamOpen = "";
+                        }
+                    }
+                }
+            }
+        }
+    }
+
+    component PanelButton: RippleButton {
+        id: panelButton
+        property string label
+        implicitHeight: 32
+        implicitWidth: panelButtonText.implicitWidth + 24
+        buttonRadius: height / 2
+        colBackground: Appearance.colors.colLayer3
+        colBackgroundHover: Appearance.colors.colLayer3Hover
+        colRipple: Appearance.colors.colLayer3Active
+        contentItem: StyledText {
+            id: panelButtonText
+            horizontalAlignment: Text.AlignHCenter
+            verticalAlignment: Text.AlignVCenter
+            font.pixelSize: Appearance.font.pixelSize.small
+            color: Appearance.colors.colOnLayer2
+            text: panelButton.label
+        }
+    }
+
+    StyledFlickable {
+        anchors.fill: parent
+        anchors.margins: 12
+        clip: true
+        contentHeight: panelColumn.implicitHeight
+
+        ColumnLayout {
+            id: panelColumn
+            width: parent.width
+            spacing: 6
+
+            RowLayout {
+                Layout.fillWidth: true
+                StyledText {
+                    Layout.fillWidth: true
+                    font.pixelSize: Appearance.font.pixelSize.larger
+                    color: Appearance.colors.colOnLayer1
+                    text: Translation.tr("Agents")
+                }
+                PanelButton {
+                    label: Translation.tr("Close")
+                    onClicked: root.shown = false
+                }
+            }
+
+            SectionTitle {
+                text: Translation.tr("Team: a model for each role")
+            }
+            TeamRow {
+                role: "main"
+                label: Translation.tr("Main agent")
+                hint: Translation.tr("Talks to you and does the work")
+                modelId: Ai.models[Ai.currentModelId]?.model ?? ""
+                canPick: false
+            }
+            TeamRow {
+                role: "advisor"
+                label: Translation.tr("Advisor")
+                hint: Translation.tr("The main agent asks it before big or risky steps")
+                modelId: Ai.opencodeTeam.advisor ?? ""
+                canSwitch: true
+            }
+            TeamRow {
+                role: "subagents"
+                label: Translation.tr("Subagents")
+                hint: Translation.tr("Smaller jobs, usually a faster model")
+                modelId: Ai.opencodeTeam.subagents ?? ""
+            }
+
+            SectionTitle {
+                text: Translation.tr("Who answers")
+            }
+            Repeater {
+                model: root.primaryAgents
+                delegate: AgentRow {
+                    required property var modelData
+                    name: modelData.name === "plan" ? Translation.tr("Plan") : Translation.tr("Build")
+                    description: modelData.description
+                    selected: Ai.opencodeAgent === modelData.name
+                    onClicked: Ai.setOpencodeAgent(modelData.name)
+                }
+            }
+
+            SectionTitle {
+                text: Translation.tr("Subagents: click one to call it in your message")
+            }
+            Repeater {
+                model: root.subagents
+                delegate: AgentRow {
+                    required property var modelData
+                    name: `@${modelData.name}`
+                    description: modelData.description
+                    kind: modelData.name
+                    onClicked: {
+                        const field = root.inputField;
+                        field.text = `@${modelData.name} ${field.text}`;
+                        field.cursorPosition = field.text.length;
+                        field.forceActiveFocus();
+                        root.shown = false;
+                    }
+                }
+            }
+
+            SectionTitle {
+                visible: root.chatAgents.length > 0
+                text: Translation.tr("In this chat")
+            }
+            Repeater {
+                model: root.chatAgents
+                delegate: Rectangle {
+                    id: chatAgent
+                    required property var modelData
+                    readonly property bool working: modelData.state === "running" || modelData.state === "waiting"
+                    readonly property bool messagesOpen: root.openAgent === modelData.id
+                    Layout.fillWidth: true
+                    implicitHeight: chatAgentColumn.implicitHeight + 16
+                    radius: Appearance.rounding.small
+                    color: Appearance.colors.colLayer2
+
+                    ColumnLayout {
+                        id: chatAgentColumn
+                        anchors {
+                            left: parent.left
+                            right: parent.right
+                            top: parent.top
+                            margins: 8
+                        }
+                        spacing: 6
+                        RowLayout {
+                            Layout.fillWidth: true
+                            spacing: 10
+                            PixelRobot {
+                                kind: chatAgent.modelData.name ?? "other"
+                                state: chatAgent.modelData.state ?? "running"
+                                pixel: 2
+                            }
+                            ColumnLayout {
+                                Layout.fillWidth: true
+                                spacing: 0
+                                StyledText {
+                                    Layout.fillWidth: true
+                                    textFormat: Text.PlainText
+                                    elide: Text.ElideRight
+                                    color: Appearance.colors.colOnLayer1
+                                    text: `@${chatAgent.modelData.name ?? ""}`
+                                }
+                                StyledText {
+                                    Layout.fillWidth: true
+                                    textFormat: Text.PlainText
+                                    elide: Text.ElideRight
+                                    font.pixelSize: Appearance.font.pixelSize.smaller
+                                    color: Appearance.colors.colOnSurfaceVariant
+                                    text: chatAgent.modelData.activity || chatAgent.modelData.task || ""
+                                }
+                            }
+                            PanelButton {
+                                visible: chatAgent.working
+                                label: Translation.tr("Stop")
+                                onClicked: Ai.runAgentTool(["stop", chatAgent.modelData.id], () => {}, error => root.panelError = error)
+                            }
+                            PanelButton {
+                                label: chatAgent.messagesOpen ? Translation.tr("Hide") : Translation.tr("Messages")
+                                onClicked: root.showMessages(chatAgent.modelData)
+                            }
+                        }
+                        StyledText {
+                            visible: chatAgent.messagesOpen
+                            Layout.fillWidth: true
+                            textFormat: Text.PlainText
+                            wrapMode: Text.Wrap
+                            font.pixelSize: Appearance.font.pixelSize.small
+                            color: Appearance.colors.colOnLayer1
+                            text: root.openText
+                        }
+                    }
+                }
+            }
+            StyledText {
+                visible: root.panelError.length > 0
+                Layout.fillWidth: true
+                textFormat: Text.PlainText
+                wrapMode: Text.Wrap
+                font.pixelSize: Appearance.font.pixelSize.small
+                color: Appearance.colors.colError
+                text: root.panelError
+            }
+
+            PanelButton {
+                visible: !root.formShown
+                Layout.topMargin: 10
+                label: Translation.tr("New subagent")
+                onClicked: root.formShown = true
+            }
+            ColumnLayout {
+                visible: root.formShown
+                Layout.fillWidth: true
+                Layout.topMargin: 10
+                spacing: 8
+                SectionTitle {
+                    text: Translation.tr("New subagent on %1. It asks before acting, like every agent").arg(Ai.models[Ai.currentModelId]?.name ?? "")
+                }
+                MaterialTextField {
+                    id: nameField
+                    Layout.fillWidth: true
+                    placeholderText: Translation.tr("Name, like translator")
+                }
+                MaterialTextField {
+                    id: descriptionField
+                    Layout.fillWidth: true
+                    placeholderText: Translation.tr("What it's for, in one line")
+                }
+                MaterialTextArea {
+                    id: promptField
+                    Layout.fillWidth: true
+                    Layout.preferredHeight: 120
+                    placeholderText: Translation.tr("Its instructions")
+                }
+                StyledText {
+                    visible: root.formError.length > 0
+                    Layout.fillWidth: true
+                    textFormat: Text.PlainText
+                    wrapMode: Text.Wrap
+                    font.pixelSize: Appearance.font.pixelSize.small
+                    color: Appearance.colors.colError
+                    text: root.formError
+                }
+                RowLayout {
+                    Layout.fillWidth: true
+                    Item {
+                        Layout.fillWidth: true
+                    }
+                    PanelButton {
